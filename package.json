{
  "name": "jurapdf",
  "private": true,
  "version": "0.6.2",
  "description": "Free, open-source, browser-based PDF viewer and editor. Sister app to JuraCAD, JuraCUT and JuraDAW.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "bench": "node scripts/bench.mjs",
    "build:claude": "node scripts/build-claude-extension.mjs",
    "check:claude": "node scripts/check-claude-extension.mjs dist/jurapdf-claude.mcpb",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "0.21.5",
    "playwright": "~1.64.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "zod": "3.25.76"
  }
}
